# Copy this file to .env.local and fill in your own Supabase project's
# values (Supabase Dashboard -> Project Settings -> API).
#
# Both are safe to ship in the client bundle (NEXT_PUBLIC_* vars are
# inlined into the built app at `next build` time) - the anon key is
# designed to be public; every table it can touch is protected by Row
# Level Security (see supabase/migrations/0001_friend_system.sql). NEVER
# put a service_role key here or anywhere in this app.
#
# Without this file, the app still runs fully - Desktop Avatar/Timer/
# CharacterPreset/Editor all work offline - only the account/friend
# features show "Supabase 설정이 필요합니다." (see
# src/lib/supabase/client.ts's isSupabaseConfigured()).
#
# IMPORTANT for the Electron desktop build specifically: these values are
# baked in at BUILD time (`npm run desktop:build:web`), not read at
# runtime - make sure .env.local exists and is correct on whichever
# machine actually runs `npm run desktop:build`.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
